<Window
    x:Class="MyAIPet.Views.GobangWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="五子棋"
    Width="650"
    Height="720"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">
    
    <Border CornerRadius="24" BorderBrush="#FFB6C1" BorderThickness="2" Background="#E0F6FF" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid>
            <!-- 标题 -->
            <TextBlock Text="五子棋 - 人机对战" 
                       FontSize="18" 
                       Foreground="#2F4F4F" 
                       HorizontalAlignment="Center" 
                       Margin="0,15"
                       FontFamily="Microsoft YaHei"/>
            
            <!-- 棋盘区域 -->
            <Border CornerRadius="20" Background="#E8F4F8" Margin="20,50,20,80">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="20" Opacity="0.3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Canvas x:Name="BoardCanvas" 
                            Width="540" 
                            Height="540" 
                            ClipToBounds="True"
                            MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown"
                            MouseMove="BoardCanvas_MouseMove"
                            MouseLeave="BoardCanvas_MouseLeave"
                            Background="Transparent"/>
                </Grid>
            </Border>
            
            <!-- 底部状态栏 -->
            <Border CornerRadius="12" Background="#FFF0F5" Margin="20,0,20,20" Height="50" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="你的回合 (黑棋)"
                               VerticalAlignment="Center"
                               Foreground="#2F4F4F"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"
                               FontSize="14"
                               FontFamily="Microsoft YaHei"/>
                    <Button Content="重新开始" 
                            Background="#7FB3D5" 
                            Foreground="#2F4F4F" 
                            BorderThickness="0" 
                            Padding="15,5" 
                            Margin="5,0"
                            Cursor="Hand"
                            Click="RestartButton_Click"
                            FontSize="13"
                            FontFamily="Microsoft YaHei">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="关闭" 
                            Background="#FFB6C1" 
                            Foreground="#2F4F4F" 
                            BorderThickness="0" 
                            Padding="15,5" 
                            Margin="5,0"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            FontSize="13"
                            FontFamily="Microsoft YaHei">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>