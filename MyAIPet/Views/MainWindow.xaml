<Window
    x:Class="MyAIPet.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyAIPet.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:converters="clr-namespace:MyAIPet.Converters"
    Title="MainWindow"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    LocationChanged="Window_LocationChanged"
    mc:Ignorable="d">
    
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="对话" Command="{Binding ToggleBubbleCommand}"/>
            <Separator/>
            <MenuItem Header="五子棋" Click="MenuItem_Gobang_Click"/>
            <Separator/>
            <MenuItem Header="设置"/>
            <MenuItem Header="关于"/>
            <Separator/>
            <MenuItem Header="退出" Click="MenuItem_Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 对话气泡 -->
        <local:ChatBubbleControl x:Name="ChatBubbleControl"
                                  Grid.Row="0"
                                  DataContext="{Binding ChatBubble}"
                                  MouseLeftButtonDown="ChatBubble_MouseLeftButtonDown"
                                  VerticalAlignment="Top"
                                  Margin="10,10,10,0"/>
        
        <!-- 角色 -->
        <Image
            x:Name="PetImage"
            Grid.Row="1"
            Source="{Binding CurrentFrame}"
            Stretch="None"
            RenderTransformOrigin="0.5,0.5"
            Cursor="Hand"
            MouseLeftButtonDown="PetImage_MouseLeftButtonDown">
            <Image.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="0.3" />
            </Image.LayoutTransform>
        </Image>
        
        <!-- 输入框 -->
        <Border Grid.Row="2"
                Background="#F0F0F0"
                CornerRadius="8"
                Padding="8"
                Margin="10,0,10,10"
                MaxWidth="300"
                Visibility="{Binding IsInputVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="TxtInput"
                         Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         FontFamily="Microsoft YaHei UI"
                         VerticalContentAlignment="Center"
                         MaxWidth="220"
                         KeyDown="InputTextBox_KeyDown"/>
                
                <Button Grid.Column="1"
                        Content="发送"
                        Width="50"
                        Height="28"
                        Background="#4A90D9"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding SendMessageCommand}"
                        FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
